# Copy to .env. Nimbus reads this file on startup. Do not commit real keys.
# A key saved in Settings replaces the matching environment variable.

DEEPSEEK_API_KEY=
COMPOSIO_API_KEY=

# Google sign-in. These are public (the publishable key is safe in the browser).
# Leave blank to use the project defaults built into the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (Desktop releases storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nimbus-releases
R2_PUBLIC_URL=https://pub-ce50cd78e02245c4afb325681955755a.r2.dev
VITE_RELEASES_URL=https://pub-ce50cd78e02245c4afb325681955755a.r2.dev



# Paystack payment gateway
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=USD

